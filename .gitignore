# dependencies
node_modules/
.bun/

# build output
dist/
*.tsbuildinfo
site/
# `bun pm pack` output — the release checklist runs it against packages/cli to confirm
# every `workspace:*` dep resolved to a concrete version, and it drops the tarball in place.
*.tgz

# local runtime state & secrets
.asterism/
*.db
*.db-journal
*.sqlite
# SQLite WAL/SHM sidecars — a database opened outside .asterism/ leaves these beside it
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm
*-wal
*-shm
.env
.env.*

