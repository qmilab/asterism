{
  "name": "@qmilab/asterism-workspace",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "bun test",
    "check:artifacts": "node scripts/no-tracked-artifacts.mjs",
    "check:artifacts:self-test": "node scripts/no-tracked-artifacts.mjs --self-test",
    "check:docs": "tsc -b && node scripts/docs-commands-check.mjs",
    "check:docs:self-test": "tsc -b && node scripts/docs-commands-check.mjs --self-test",
    "check:safety-case": "node scripts/safety-case-check.mjs",
    "check:safety-case:self-test": "node scripts/safety-case-check.mjs --self-test",
    "check:mkdocs-parity": "node scripts/mkdocs-parity-check.mjs",
    "check:mkdocs-parity:self-test": "node scripts/mkdocs-parity-check.mjs --self-test",
    "verify:node": "tsc -b && node scripts/node-acceptance.mjs",
    "verify:deno": "tsc -b && deno run -A scripts/deno-acceptance.mjs",
    "asterism": "bun run packages/cli/src/bin.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^20.0.0",
    "typescript": "^5.6.0"
  }
}
